<Controls:MetroWindow x:Class="EEPK_Organiser.Forms.AssetContainerSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EEPK_Organiser.Forms"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:undoRedo="clr-namespace:Xv2CoreLib.Resource.UndoRedo;assembly=Xv2CoreLib"
        mc:Ignorable="d"
        Title="Asset Type Settings" Height="200" Width="300" WindowStyle="ToolWindow" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" x:Name="Window" TitleCharacterCasing="Normal">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl"  Command="{Binding Source={x:Static undoRedo:UndoManager.Instance}, Path=UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl"  Command="{Binding Source={x:Static undoRedo:UndoManager.Instance}, Path=RedoCommand}"/>
    </Window.InputBindings>
    <Grid Margin="5">
        <StackPanel HorizontalAlignment="Left">
            <Grid Margin="3,5,0,0" Width="280">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="poolSizeLabel" Content="Pool Size"/>
                <Controls:NumericUpDown Grid.Column="1" Value="{Binding ElementName=Window, Path=ViewModel.PoolSize}"/>
            </Grid>
            <Grid Margin="3,5,0,0" Width="280" x:Name="particleConfig1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Particle Config 1"/>
                <Controls:NumericUpDown Grid.Column="1" Value="{Binding ElementName=Window, Path=ViewModel.ParticleEngineConfig1}" Minimum="0" Maximum="255"/>
            </Grid>
            <Grid Margin="3,5,0,0" Width="280" x:Name="particleConfig2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Particle Config 2" ToolTip="Affects the amount of assets that can be loaded by the game. It's not a direct count, but a higher number generally means more can be loaded.&#x0a;&#x0a;If the limit defined here is insufficient for the amount of assets, the game WILL crash!"/>
                <Controls:NumericUpDown Grid.Column="1" Value="{Binding ElementName=Window, Path=ViewModel.ParticleEngineConfig2}"/>
            </Grid>
            <Grid Margin="3,5,0,0" Width="280" x:Name="particleConfig3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Particle Config 3"/>
                <Controls:NumericUpDown Grid.Column="1" Value="{Binding ElementName=Window, Path=ViewModel.ParticleEngineConfig3}"/>
            </Grid>
            <Grid Margin="3,5,0,0" Width="280" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Auto Calculate" ToolTip="Auto generate an appropriate pool size and (if PBIND) particle config values when saving the eepk.&#x0a;&#x0a;The generated pool size will be equal or slightly greater than the number of assets (rounded up to nearest multiply of 4). The particle config values will then be derived from the pool size."/>
                <CheckBox Grid.Column="1" IsChecked="{Binding ElementName=Window, Path=ViewModel.AutoGenerate, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </StackPanel>
    </Grid>
</Controls:MetroWindow>
