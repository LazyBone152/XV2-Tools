<mvvm:AutoObservableUserControl x:Class="EEPK_Organiser.View.EepkEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
             xmlns:lbUtils="clr-namespace:LB_Common.Utils;assembly=LB_Common"
             xmlns:helper="clr-namespace:LB_Common.AttachedProperties;assembly=LB_Common"
             xmlns:eepk="clr-namespace:Xv2CoreLib.EEPK;assembly=Xv2CoreLib"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:mvvm="clr-namespace:LB_Common.Mvvm;assembly=LB_Common"
             xmlns:forms="clr-namespace:EEPK_Organiser.Forms"
             xmlns:eepkDic="clr-namespace:Xv2CoreLib.ValuesDictionary;assembly=Xv2CoreLib"
             xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:viewModel="clr-namespace:EEPK_Organiser.ViewModel"
             xmlns:view="clr-namespace:EEPK_Organiser.View"
             mc:Ignorable="d" 
             d:DesignHeight="6000" d:DesignWidth="900" Dialog:DialogParticipation.Register="{Binding}" Name="UserControl">
    <mvvm:AutoObservableUserControl.Resources>
        <Style x:Key="ExpandableDataGridHeaderStyle" TargetType="{x:Type DataGridRowHeader}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray5}" />
            <Setter Property="BorderThickness" Value="0 0 1 0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridRowHeader}">
                        <Grid>
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,5,0,0">
                                <iconPacks:PackIconMaterialLight Kind="ArrowDown" Width="12" Height="12" VerticalAlignment="Center"
                                                             Visibility="{Binding Path=DetailsVisibility, 
                                                             RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                             Converter={StaticResource inverseVisibilityConverter}}"
                                                             HorizontalAlignment="Center"/>
                                <iconPacks:PackIconMaterialLight Kind="ArrowUp" Width="12" Height="12" VerticalAlignment="Center"
                                                             Visibility="{Binding Path=DetailsVisibility, 
                                                             RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                             HorizontalAlignment="Center"/>
                            </Grid>
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0" Background="{DynamicResource MahApps.Brushes.Accent}">
                                <ToggleButton x:Name="ExpanderToggleButton" Focusable="False"
                                      IsChecked="{Binding Path=DetailsVisibility,
                                                          RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                          Converter={StaticResource visibilityConverter},
                                                          Mode=TwoWay}"
                                      Style="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}"
                                      Foreground="Transparent" Background="Transparent" BorderBrush="Transparent"
                                      Width="{Binding Path=RowHeaderWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </mvvm:AutoObservableUserControl.Resources>
    <Grid x:Name="rootGrid">
        <Grid.Resources>
            <lbUtils:BindingProxy x:Key="proxy" Data="{Binding}"/>
            <ObjectDataProvider x:Key="drawPassEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="viewModel:EmoDrawPass"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </Grid.Resources>

        <TabControl x:Name="tabControl" SelectionChanged="TabControl_SelectionChanged" Controls:TabControlHelper.Underlined="TabItems" IsEnabled="{Binding IsFileLoaded}" Margin="0, 4">

            <Controls:MetroTabItem Header="EFFECT" Controls:HeaderedControlHelper.HeaderFontSize="14">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="0.55*"/>
                        <ColumnDefinition Width="*" MinWidth="500" MaxWidth="600"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="effectDataGrid" Grid.Column="1" Tag="{Binding DataContext, ElementName=rootGrid}" SelectionChanged="EffectDataGrid_SelectionChanged" VirtualizingPanel.ScrollUnit="Pixel"
                              ItemsSource="{Binding effectContainerFile.ViewEffects}" SelectedItem="{Binding SelectedEffect, UpdateSourceTrigger=PropertyChanged}" EnableRowVirtualization="True" 
                              EnableColumnVirtualization="True" SelectionMode="Extended" CanUserResizeRows="False" CanUserAddRows="False" 
                              AutoGenerateColumns="False" CanUserDeleteRows="False" CellEditEnding="EffectDataGrid_CellEditEnding"
                              HeadersVisibility="Row" RowHeaderWidth="25" RowDetailsVisibilityMode="Collapsed" RowHeaderStyle="{DynamicResource ExpandableDataGridHeaderStyle}"
                              SelectionUnit="FullRow"
                              BorderBrush="{DynamicResource MahApps.Brushes.Gray.SemiTransparent}" BorderThickness="1"
                              helper:DataGridHelper.SelectedItems="{Binding ElementName=UserControl, Path=SelectedEffects, Mode=OneWay}">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding ElementName=UserControl, Path=Effect_DeleteEffectCommand}"/>
                            <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding ElementName=UserControl, Path=EffectNewCommand}"/>
                            <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding ElementName=UserControl, Path=Effect_CopyCommand}"/>
                            <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding ElementName=UserControl, Path=Effect_PasteCommand}"/>
                            <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding ElementName=UserControl, Path=Effect_DuplicateCommand}"/>
                            <KeyBinding Key="F2" Command="{Binding ElementName=UserControl, Path=EffectRenameBeginCommand}"/>
                            <KeyBinding Key="Return" Command="{Binding ElementName=UserControl, Path=EffectRenameCommitCommand}"/>
                        </DataGrid.InputBindings>

                        <DataGrid.ContextMenu>
                            <ContextMenu FontSize="12">
                                <MenuItem Header="Rename" Command="{Binding PlacementTarget.Tag.EffectRenameBeginCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Play" Command="{Binding PlacementTarget.Tag.PlaySelectedEffectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Visibility="{Binding PlacementTarget.Tag.XenoKitVisible, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>

                                <MenuItem Header="New Effect Part" Command="{Binding PlacementTarget.Tag.Effect_AddEffectPartCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Paste Effect Part" Command="{Binding PlacementTarget.Tag.EffectPart_PasteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Copy" Command="{Binding PlacementTarget.Tag.Effect_CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Paste" Command="{Binding PlacementTarget.Tag.Effect_PasteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Delete" Command="{Binding PlacementTarget.Tag.Effect_DeleteEffectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Duplicate" Command="{Binding PlacementTarget.Tag.Effect_DuplicateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Export" Command="{Binding PlacementTarget.Tag.Effect_ExportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="ID" Width="Auto" MinWidth="90" SortMemberPath="IndexNum">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IndexNum}" TextAlignment="Left" Margin="5,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <Controls:NumericUpDown Value="{Binding ElementName=UserControl, Path=SelectedEffectID, UpdateSourceTrigger=LostFocus}" Minimum="0" Maximum="65535" TextAlignment="Left" Margin="0,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="nameListColumn" Header="Name" Width="*" Binding="{Binding UserDefinedName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                        </DataGrid.Columns>

                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <ListBox BorderBrush="{DynamicResource MahApps.Brushes.Accent2}" MouseDoubleClick="EffectPartListBox_MouseDoubleClick" PreviewMouseWheel="ListBox_PreviewMouseWheel" BorderThickness="1" 
                                         SelectionChanged="EffectPart_SelectionChanged" VirtualizingPanel.ScrollUnit="Pixel" ItemsSource="{Binding EffectParts.Binding}" SelectionMode="Extended" 
                                         SelectedItem="{Binding Data.SelectedEffectPart, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}"
                                         helper:ListBoxHelper.SelectedItems="{Binding Data.SelectedEffectParts, Source={StaticResource proxy}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewMouseDown="EffectPartListBox_PreviewMouseDown">
                                    
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding EffectPartDetails}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                    <ListBox.InputBindings>
                                        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding Data.Effect_AddEffectPartCommand, Source={StaticResource proxy}}"/>
                                        <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding Data.EffectPart_CopyCommand, Source={StaticResource proxy}}"/>
                                        <KeyBinding Modifiers="Ctrl" Key="V" Command="{Binding Data.EffectPart_PasteCommand, Source={StaticResource proxy}}"/>
                                        <KeyBinding Modifiers="Ctrl" Key="X" Command="{Binding Data.EffectPart_PasteValuesCommand, Source={StaticResource proxy}}"/>
                                        <KeyBinding Modifiers="Ctrl" Key="D" Command="{Binding Data.EffectPart_DuplicateCommand, Source={StaticResource proxy}}"/>
                                        <KeyBinding Key="Delete" Command="{Binding Data.EffectPart_DeleteCommand, Source={StaticResource proxy}}"/>
                                        <KeyBinding Key="Return" Command="{Binding Data.EffectPart_DoubleClickCommand, Source={StaticResource proxy}}"/>
                                    </ListBox.InputBindings>
                                    <ListBox.ContextMenu>
                                        <ContextMenu FontSize="12">
                                            <MenuItem Header="New" Command="{Binding Data.Effect_AddEffectPartCommand, Source={StaticResource proxy}}"/>
                                            <MenuItem Header="Delete" Command="{Binding Data.EffectPart_DeleteCommand, Source={StaticResource proxy}}"/>
                                            <MenuItem Header="Duplicate" Command="{Binding Data.EffectPart_DuplicateCommand, Source={StaticResource proxy}}"/>
                                            <MenuItem Header="Copy" Command="{Binding Data.EffectPart_CopyCommand, Source={StaticResource proxy}}"/>
                                            <MenuItem Header="Paste" Command="{Binding Data.EffectPart_PasteCommand, Source={StaticResource proxy}}"/>
                                            <MenuItem Header="Paste Value" Command="{Binding Data.EffectPart_PasteValuesCommand, Source={StaticResource proxy}}"/>
                                            <Separator/>
                                            <MenuItem Header="Rescale" Command="{Binding Data.EffectPart_RescaleCommand, Source={StaticResource proxy}}"/>
                                            <MenuItem Header="Change Asset" Command="{Binding Data.EffectPart_ChangeAssetCommand, Source={StaticResource proxy}}"/>
                                            <Separator/>
                                            <MenuItem Header="Go To Asset" Command="{Binding Data.EffectPart_GoToAssetCommand, Source={StaticResource proxy}}"/>
                                            <MenuItem Header="Edit Asset" Command="{Binding Data.EffectPart_OpenEditorCommand, Source={StaticResource proxy}}"/>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                </ListBox>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>

                    <Border Grid.Column="2" BorderBrush="{DynamicResource MahApps.Brushes.Gray.SemiTransparent}" BorderThickness="1" Margin="5, 0">
                        <Grid>
                            <ScrollViewer Grid.Column="2" Visibility="{Binding ElementName=UserControl, Path=EffectPartVisibility}">
                                <Grid Background="Transparent">
                                    <StackPanel>
                                        <Expander x:Name="effectPartGeneral" Header="General" IsExpanded="True">
                                            <StackPanel Margin="0,0,0,2.5">
                                                <StackPanel HorizontalAlignment="Left">
                                                    <Grid Margin="3,3,0,0" Width="400">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="122.5"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="75"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Asset"/>
                                                        <TextBox Grid.Column="1" IsEnabled="False" Text="{Binding SelectedEffectPart.AssetRefDetails, Mode=OneWay}" IsReadOnly="True"  TextWrapping="NoWrap" VerticalAlignment="Top"/>
                                                        <Button Grid.Column="2" Margin="5,0" Command="{Binding ElementName=UserControl, Path=EffectPart_ChangeAssetCommand}" Content="Change"/>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal">
                                                    <Grid Margin="3,5,0,0" Width="245">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Start Delay" ToolTip="Delay starting of the effect by N frames."/>
                                                        <Controls:NumericUpDown Grid.Column="1" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.StartTime, UpdateSourceTrigger=PropertyChanged}" Minimum="0"/>
                                                    </Grid>
                                                    <Grid Margin="3,5,0,0" Width="245">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Deactivation Mode" ToolTip="Controls how this effect will end when it receives a termination request. Regardless of this setting the effect will be deactivated when it naturally ends, as long as it is not looped.&#x0a;&#x0a;Never:&#x0a;This effect can not be deactivated&#x0a;&#x0a;Immediate:&#x0a;This effect will immediately end when deactivated&#x0a;&#x0a;Loop Cancel:&#x0a;This effect will end when deactivated, but not immediately. &#x0a;[PBIND] Looped particles will end immediately, however any non-looped particles will remain active for their remaining lifetime, and can still create new (non-looped) particles."/>
                                                        <ComboBox Grid.Column="1" SelectedValue="{Binding ElementName=UserControl, Path=EffectPartViewModel.Deactivation, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Value" SelectedValuePath="Key" ItemsSource="{x:Static eepkDic:EEPK.Deactivation}"/>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Visibility="{Binding ElementName=UserControl, Path=EffectPartViewModel.IsNotCBIND, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid Margin="3,5,0,0" Width="245">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Orientation Type"/>
                                                        <ComboBox Grid.Column="1" SelectedValue="{Binding ElementName=UserControl, Path=EffectPartViewModel.OrientationType, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Value" SelectedValuePath="Key" ItemsSource="{x:Static eepkDic:EEPK.Orientation}"/>
                                                    </Grid>
                                                    <Grid Margin="3,3,0,0" Width="245">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Direction"/>
                                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding ElementName=UserControl, Path=EffectPartViewModel.DirectionAxis, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{x:Static eepkDic:EEPK.DirectionAxis}"/>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Width="500" HorizontalAlignment="Left" Visibility="{Binding ElementName=UserControl, Path=EffectPartViewModel.IsNotCBIND, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Margin="3,5,0,0" Width="245">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Label Content="Attachment Type"/>
                                                            <ComboBox Grid.Column="1" SelectedValue="{Binding ElementName=UserControl, Path=EffectPartViewModel.Attachment, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Value" SelectedValuePath="Key" ItemsSource="{x:Static eepkDic:EEPK.AttachmentTypes}"/>
                                                        </Grid>
                                                        <Grid Margin="3,5,0,0" Width="245">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Label Content="Attachment Bone"/>
                                                            <ComboBox Grid.Column="1" IsEditable="True" Text="{Binding ElementName=UserControl, Path=EffectPartViewModel.ESK, UpdateSourceTrigger=LostFocus}" ItemsSource="{x:Static eepkDic:EEPK.CommonBones}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Margin="3,5,0,0" Width="245" HorizontalAlignment="Left">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="122.5"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Label Content="Position Update" ToolTip="Update the effect position every frame. If not set, then the effect will keep it's initial position for its entire lifespan."/>
                                                            <CheckBox Grid.Column="1" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.I_32_0, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </Grid>
                                                        <Grid Margin="3,5,0,0" Width="245" HorizontalAlignment="Left">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="122.5"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Label Content="Rotation Update" ToolTip="Update the effect orientation every frame. If not set, then the effect will keep it's initial orientation for its entire lifespan."/>
                                                            <CheckBox Grid.Column="1" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.I_32_1, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                    <Grid Margin="3,5,0,0" Width="245" HorizontalAlignment="Left">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="122.5"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Instant Update" ToolTip="Instantly update particle position and orientation to move with the attached bone (requires either the Position Update or Rotation Update flag to have any effect).&#x0a;&#x0a;Without this, particle nodes will only be created at the bone position, but wont update with it throughout their lifetime."/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.I_32_2, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Grid Margin="3,5,0,0" Width="245" HorizontalAlignment="Left">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="122.5"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Use Time Scale" ToolTip="Inherit the Time Scale value of the user of this effect."/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.I_32_4, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                    <Grid Margin="3,5,0,0" Width="245" HorizontalAlignment="Left">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="122.5"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Ground Check" ToolTip="Flags the effect to only appear if it passes a Y-axis check (near or on the ground). Additionally will also perform a check per frame, and will terminate the effect if it fails."/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.I_32_3, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Width="500" HorizontalAlignment="Left" Visibility="{Binding ElementName=UserControl, Path=EffectPartViewModel.IsLIGHT, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Label Content="Light Settings" ToolTip="By default all these flags are active, but if any of them are enabled here then the others will become inactive." FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0, 2"/>
                                                    <StackPanel Orientation="Horizontal" Margin="5,0">
                                                        <CheckBox Width="160" Margin="3,1" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.I_36_4, UpdateSourceTrigger=PropertyChanged}" Content="Apply to Characters"/>
                                                        <CheckBox Width="160" Margin="3,1" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.I_36_5, UpdateSourceTrigger=PropertyChanged}" Content="Apply to Stages"/>
                                                        <CheckBox Width="160" Margin="3,1" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.I_36_6, UpdateSourceTrigger=PropertyChanged}" Content="Unk 6" ToolTip="Related to the other light flags somehow. Likely for the light affecting something else."/>
                                                    </StackPanel>
                                                </StackPanel>



                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="Render Options" IsExpanded="True" Visibility="{Binding ElementName=UserControl, Path=EffectPartViewModel.IsNotCBIND, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel MaxWidth="500" HorizontalAlignment="Left" Margin="0,0,0,2.5">
                                                <Grid Margin="3,5,0,0" Width="245" HorizontalAlignment="Left">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Label Content="Depth Bias"/>
                                                    <Controls:NumericUpDown Grid.Column="1" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.DepthBias, UpdateSourceTrigger=PropertyChanged}" StringFormat="0.00" Interval="0.05"/>
                                                </Grid>
                                                <Grid Margin="3,5,0,0" Width="245" HorizontalAlignment="Left" Visibility="{Binding ElementName=UserControl, Path=EffectPartViewModel.IsEMO, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Label Content="Draw Pass"/>
                                                    <ComboBox Grid.Column="1" SelectedItem="{Binding ElementName=UserControl, Path=EffectPartViewModel.EmoDrawPass}" ItemsSource="{Binding Source={StaticResource ResourceKey=drawPassEnum}}"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Grid Margin="3,5,0,0" Width="245" HorizontalAlignment="Left" Visibility="{Binding ElementName=UserControl, Path=EffectPartViewModel.IsNotLIGHT, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="122.5"/>
                                                            <ColumnDefinition Width="20"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Distance Fading" ToolTip="Enable fading of the effect according to the Near Fade Distance and Far Fade Distance values."/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.EnableDistanceCulling, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                    <Grid Margin="3,5,0,0" Width="245" HorizontalAlignment="Left" IsEnabled="{Binding ElementName=UserControl, Path=EffectPartViewModel.EnableDistanceCulling}" Visibility="{Binding ElementName=UserControl, Path=EffectPartViewModel.IsEMO, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="122.5"/>
                                                            <ColumnDefinition Width="20"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="No Frustum Culling" ToolTip="Disable frustum culling when drawing this EMO. Useful for animated EMOs where the bounding boxes used for culling are no longer accurate to the animated shape."/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.EnableDistanceCulling, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding ElementName=UserControl, Path=EffectPartViewModel.IsNotLIGHT, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid Margin="3,5,0,0" Width="245">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Near Fade Distance"/>
                                                        <Controls:NumericUpDown Grid.Column="1" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.F_84, UpdateSourceTrigger=PropertyChanged}" StringFormat="0.00" Interval="0.05"/>
                                                    </Grid>
                                                    <Grid Margin="3,5,0,0" Width="245">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Far Fade Distance"/>
                                                        <Controls:NumericUpDown Grid.Column="1" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.F_88, UpdateSourceTrigger=PropertyChanged}" StringFormat="0.00" Interval="0.05"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="Position / Rotation / Scale" IsExpanded="True" Visibility="{Binding ElementName=UserControl, Path=EffectPartViewModel.IsNotCBIND, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel MaxWidth="500" HorizontalAlignment="Left" Margin="0,0,0,2.5">

                                                <StackPanel Width="500" HorizontalAlignment="Left">
                                                    <TextBlock Text="Position Offset" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0, 2"/>
                                                    <Grid Margin="3,5,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="111"/>

                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="112"/>

                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="112"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Position" ToolTip="Applies a position offset to the effect in addition to its spawn location (as determined by Attachment).&#x0a;&#x0a;When Bone Direction is enabled, the position offset will be applied relative to the Attachment Bone."/>
                                                        <Label Grid.Column="1" Content="X" HorizontalContentAlignment="Right"/>
                                                        <Controls:NumericUpDown Grid.Column="2" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.POSITION_X, UpdateSourceTrigger=PropertyChanged}" StringFormat="0.00" Interval="0.01"/>

                                                        <Label Grid.Column="3" Content="Y" HorizontalContentAlignment="Right"/>
                                                        <Controls:NumericUpDown Grid.Column="4" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.POSITION_Y, UpdateSourceTrigger=PropertyChanged}" StringFormat="0.00" Interval="0.01"/>

                                                        <Label Grid.Column="5" Content="Z" HorizontalContentAlignment="Right"/>
                                                        <Controls:NumericUpDown Grid.Column="6" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.POSITION_Z, UpdateSourceTrigger=PropertyChanged}" StringFormat="0.00" Interval="0.01"/>
                                                    </Grid>
                                                    <Grid Margin="3,5,0,0" Width="140" HorizontalAlignment="Left">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Bone Direction" ToolTip="These position values will be relative to the bone direction if enabled, otherwise they will be in world space."/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.I_32_5, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Width="500" HorizontalAlignment="Left" Visibility="{Binding ElementName=UserControl, Path=EffectPartViewModel.IsNotLIGHT, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Rotation" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0, 2"/>
                                                    <Grid Margin="3,5,0,0" Width="140" HorizontalAlignment="Left">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Enable Rotation"/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.I_32_6, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                    <Grid Margin="3,5,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="111"/>

                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="112"/>

                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="112"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Rotation (Min)"/>
                                                        <Label Grid.Column="1" Content="X" HorizontalContentAlignment="Right"/>
                                                        <Controls:NumericUpDown Grid.Column="2" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.F_52, UpdateSourceTrigger=PropertyChanged}" StringFormat="0.00" Interval="0.01"/>

                                                        <Label Grid.Column="3" Content="Y" HorizontalContentAlignment="Right"/>
                                                        <Controls:NumericUpDown Grid.Column="4" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.F_60, UpdateSourceTrigger=PropertyChanged}" StringFormat="0.00" Interval="0.01"/>

                                                        <Label Grid.Column="5" Content="Z" HorizontalContentAlignment="Right"/>
                                                        <Controls:NumericUpDown Grid.Column="6" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.F_68, UpdateSourceTrigger=PropertyChanged}" StringFormat="0.00" Interval="0.01"/>
                                                    </Grid>
                                                    <Grid Margin="3,5,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="111"/>

                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="112"/>

                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="112"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Rotation (Max)"/>
                                                        <Label Grid.Column="1" Content="X" HorizontalContentAlignment="Right"/>
                                                        <Controls:NumericUpDown Grid.Column="2" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.F_56, UpdateSourceTrigger=PropertyChanged}" StringFormat="0.00" Interval="0.01"/>

                                                        <Label Grid.Column="3" Content="Y" HorizontalContentAlignment="Right"/>
                                                        <Controls:NumericUpDown Grid.Column="4" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.F_64, UpdateSourceTrigger=PropertyChanged}" StringFormat="0.00" Interval="0.01"/>

                                                        <Label Grid.Column="5" Content="Z" HorizontalContentAlignment="Right"/>
                                                        <Controls:NumericUpDown Grid.Column="6" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.F_72, UpdateSourceTrigger=PropertyChanged}" StringFormat="0.00" Interval="0.01"/>
                                                    </Grid>
                                                </StackPanel>
                                                

                                                <StackPanel>
                                                    <TextBlock Text="Scale" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0, 2"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Margin="3,5,0,0" Width="245" Visibility="{Binding ElementName=UserControl, Path=EffectPartViewModel.IsNotCBIND, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Label Content="Scale (Min)" ToolTip="Scales the Effect Part. The actual scale will be randomly chosen between the Min and Max value.&#x0a;&#x0a;Not applicable for TBIND."/>
                                                            <Controls:NumericUpDown Grid.Column="1" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.SIZE_1, UpdateSourceTrigger=PropertyChanged}" StringFormat="0.00" Interval="0.01" IsEnabled="{Binding EffectPartViewModel.IsNotTBIND}"/>
                                                        </Grid>
                                                        <Grid Margin="3,5,0,0" Width="245" Visibility="{Binding ElementName=UserControl, Path=EffectPartViewModel.IsNotCBIND, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Label Content="Scale (Max)" ToolTip="Scales the Effect Part. The actual scale will be randomly chosen between the Min and Max value.&#x0a;&#x0a;Not applicable for TBIND."/>
                                                            <Controls:NumericUpDown Grid.Column="1" Value="{Binding EffectPartViewModel.SIZE_2, UpdateSourceTrigger=PropertyChanged}" StringFormat="0.00" Interval="0.01" IsEnabled="{Binding EffectPartViewModel.IsNotTBIND}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                    <Grid Margin="3,5,0,0" Width="490" HorizontalAlignment="Left">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="122.5"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Inherit Users Scale"/>
                                                        <CheckBox Grid.Column="1" Width="80" Content="Start" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.InheritUsersScaleOnStart, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ElementName=UserControl, Path=EffectPartViewModel.IsEmoOrPbind, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <CheckBox Grid.Column="2" Width="80" Content="Update" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.InheritUsersScaleOnUpdate, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                    <Grid Margin="3,5,0,0" Width="490" HorizontalAlignment="Left">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="122.5"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Inherit Bone Scale"/>
                                                        <CheckBox Grid.Column="1" Width="80" Content="Start" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.InheritBoneScaleOnStart, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ElementName=UserControl, Path=EffectPartViewModel.IsEmoOrPbind, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <CheckBox Grid.Column="2" Width="80" Content="Update" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.InheritBoneScaleOnUpdate, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>

                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="Animation" Visibility="{Binding ElementName=UserControl, Path=EffectPartViewModel.IsUsingEma, Converter={StaticResource BooleanToVisibilityConverter}}" IsExpanded="True">
                                            <StackPanel Margin="0,0,0,2.5">
                                                <WrapPanel>
                                                    <Grid Margin="3,5,0,0" Width="245">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Animation ID" ToolTip="ID of animation within the EMA file for this asset."/>
                                                        <Controls:NumericUpDown Grid.Column="1" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.I_30, UpdateSourceTrigger=PropertyChanged}" Minimum="0"/>
                                                    </Grid>

                                                    <Grid Margin="3,5,0,0" Width="245">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Enable Looping"/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding ElementName=UserControl, Path=EffectPartViewModel.I_36_0, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                </WrapPanel>
                                                <WrapPanel>
                                                    <Grid Margin="3,5,0,0" Width="245">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="Start Frame"/>
                                                        <Controls:NumericUpDown Grid.Column="1" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.I_92, UpdateSourceTrigger=PropertyChanged}" Minimum="0"/>
                                                    </Grid>
                                                    <Grid Margin="3,5,0,0" Width="245">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Content="End Frame"/>
                                                        <Controls:NumericUpDown Grid.Column="1" Value="{Binding ElementName=UserControl, Path=EffectPartViewModel.I_94, UpdateSourceTrigger=PropertyChanged}" Minimum="0"/>
                                                    </Grid>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="Unknown Flags" IsExpanded="False">
                                            <WrapPanel Margin="0,0,0,2.5">
                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_39_3, UpdateSourceTrigger=PropertyChanged}" Content="_BoneDir_UnkScale" ToolTip="Requires Bone Direction flag. Applies some scale to the position offset... how and for what reason is currently unknown."/>
                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_39_7, UpdateSourceTrigger=PropertyChanged}" Content="_ObjectRotation_To_XXXX"/>
                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_32_7, UpdateSourceTrigger=PropertyChanged}" Content="SceneCenterToBoneDir"/>

                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_39_1, UpdateSourceTrigger=PropertyChanged}" Content="Flag__39__Unk1"/>
                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_39_6, UpdateSourceTrigger=PropertyChanged}" Content="Flag__39__Unk6"/>

                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_36_1, UpdateSourceTrigger=PropertyChanged}" Content="Flag__36__Unk1"/>
                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_36_2, UpdateSourceTrigger=PropertyChanged}" Content="Flag__36__Unk2"/>
                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_36_3, UpdateSourceTrigger=PropertyChanged}" Content="Flag__36__Unk3"/>
                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_36_7, UpdateSourceTrigger=PropertyChanged}" Content="Flag__36__Unk7"/>

                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_37_0, UpdateSourceTrigger=PropertyChanged}" Content="Flag__37__Unk0"/>
                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_37_1, UpdateSourceTrigger=PropertyChanged}" Content="Flag__37__Unk1"/>
                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_37_2, UpdateSourceTrigger=PropertyChanged}" Content="Flag__37__Unk2"/>
                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_37_3, UpdateSourceTrigger=PropertyChanged}" Content="Flag__37__Unk3"/>
                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_37_4, UpdateSourceTrigger=PropertyChanged}" Content="Flag__37__Unk4"/>
                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_37_5, UpdateSourceTrigger=PropertyChanged}" Content="Flag__37__Unk5"/>
                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_37_6, UpdateSourceTrigger=PropertyChanged}" Content="Flag__37__Unk6"/>
                                                <CheckBox Width="160" Margin="3,1" IsChecked="{Binding EffectPartViewModel.I_37_7, UpdateSourceTrigger=PropertyChanged}" Content="Flag__37__Unk7"/>
                                            </WrapPanel>
                                        </Expander>
                                    </StackPanel>

                                </Grid>
                            </ScrollViewer>

                            <TextBlock Text="&lt;Select an Effect Part to edit its details>" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ElementName=UserControl, Path=NoEffectPartVisibility}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="0,20,0,0" VerticalAlignment="Top">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Margin" Value="0,5,0,0"/>
                            </Style>
                        </StackPanel.Resources>
                        <StackPanel VerticalAlignment="Center">
                            <Button Command="{Binding ElementName=UserControl, Path=EffectNewCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30" Style="{DynamicResource MahApps.Styles.Button.Circle}">
                                <iconPacks:PackIconMaterialLight Kind="Plus" />
                            </Button>
                            <TextBlock Text="New" HorizontalAlignment="Center" FontSize="10"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <Button HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30" Style="{DynamicResource MahApps.Styles.Button.Circle}" lbUtils:ContextMenuLeftClickBehavior.IsLeftClickEnabled="True">
                                <Button.ContextMenu>
                                    <ContextMenu FontSize="12">
                                        <MenuItem Header="Load External EEPK" Command="{Binding ImportEffectsFromFileCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="CMN" Command="{Binding ImportEffectsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.CMN}"/>
                                        <MenuItem Header="Character" Command="{Binding ImportEffectsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.Character}"/>
                                        <MenuItem Header="Super Skill" Command="{Binding ImportEffectsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.SuperSkill}"/>
                                        <MenuItem Header="Ultimate Skill" Command="{Binding ImportEffectsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.UltimateSkill}"/>
                                        <MenuItem Header="Evasive Skill" Command="{Binding ImportEffectsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.EvasiveSkill}"/>
                                        <MenuItem Header="Blast Skill/Type" Command="{Binding ImportEffectsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.BlastSkill}"/>
                                        <MenuItem Header="Awoken Skill" Command="{Binding ImportEffectsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.AwokenSkill}"/>
                                        <MenuItem Header="Demo" Command="{Binding ImportEffectsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.Demo}"/>
                                        <Separator/>
                                        <MenuItem Header="From Cached Files" ItemsSource="{Binding Data.cacheManager.CachedFiles, Source={StaticResource proxy}}" MouseMove="MenuItem_MouseMove" Click="EffectOptions_ImportEffectsFromCache_Click">
                                            <MenuItem.ItemContainerStyle>
                                                <Style>
                                                    <Setter Property="MenuItem.Header" Value="{Binding DisplayName}" />
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>

                                    </ContextMenu>
                                </Button.ContextMenu>

                                <iconPacks:PackIconMaterialLight Kind="FolderPlus" />
                            </Button>
                            <TextBlock Text="Import" HorizontalAlignment="Center" FontSize="10"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center">
                            <Button Command="{Binding ElementName=UserControl, Path=Effect_DeleteEffectCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30" Style="{DynamicResource MahApps.Styles.Button.Circle}">
                                <iconPacks:PackIconMaterialLight Kind="Delete" />
                            </Button>
                            <TextBlock Text="Remove" HorizontalAlignment="Center" FontSize="10"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <Button Command="{Binding ElementName=UserControl, Path=Effect_DuplicateCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30" Style="{DynamicResource MahApps.Styles.Button.Circle}">
                                <iconPacks:PackIconMaterialLight Kind="ContentDuplicate" />
                            </Button>
                            <TextBlock Text="Duplicate" HorizontalAlignment="Center" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Controls:MetroTabItem>

            <Controls:MetroTabItem Header="PBIND" Controls:HeaderedControlHelper.HeaderFontSize="14">
                <view:AssetContainerView x:Name="pbindView" AssetContainer="{Binding ElementName=UserControl, Path=effectContainerFile.Pbind}"/>
            </Controls:MetroTabItem>
            <Controls:MetroTabItem Header="TBIND" Controls:HeaderedControlHelper.HeaderFontSize="14">
                <view:AssetContainerView x:Name="tbindView" AssetContainer="{Binding ElementName=UserControl, Path=effectContainerFile.Tbind}"/>
            </Controls:MetroTabItem>
            <Controls:MetroTabItem Header="CBIND" Controls:HeaderedControlHelper.HeaderFontSize="14">
                <view:AssetContainerView x:Name="cbindView" AssetContainer="{Binding ElementName=UserControl, Path=effectContainerFile.Cbind}"/>
            </Controls:MetroTabItem>
            <Controls:MetroTabItem Header="EMO" Controls:HeaderedControlHelper.HeaderFontSize="14">
                <view:AssetContainerView x:Name="emoView" AssetContainer="{Binding ElementName=UserControl, Path=effectContainerFile.Emo}"/>
            </Controls:MetroTabItem>
            <Controls:MetroTabItem Header="LIGHT" Controls:HeaderedControlHelper.HeaderFontSize="14">
                <view:AssetContainerView x:Name="lightView" AssetContainer="{Binding ElementName=UserControl, Path=effectContainerFile.LightEma}"/>
            </Controls:MetroTabItem>

        </TabControl>

        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Width="216" Margin="0,0,10,0" IsEnabled="{Binding IsFileLoaded}">

            <!-- Tool menu for when embedded on XenoKit  -->
            <Button lbUtils:ContextMenuLeftClickBehavior.IsLeftClickEnabled="True" HorizontalAlignment="Right" VerticalAlignment="Top" Width="25" Style="{DynamicResource MahApps.Styles.Button.Circle}" Height="25" Margin="0,0,181,0" Visibility="{Binding ElementName=UserControl, Path=XenoKitVisible}">
                <iconPacks:Material Kind="Tools" />
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Hue Adjustment" Command="{Binding ToolMenu_HueAdjustCommand}"/>
                        <MenuItem Header="Hue Set" Command="{Binding ToolMenu_HueSetCommand}"/>
                        <Separator/>
                        <MenuItem Header="Optimize Textures" Command="{Binding ToolMenu_CreateSuperTextureCommand}"/>
                        <MenuItem Header="Clean All" Command="{Binding ToolMenu_CleanAllCommand}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <TextBox TextChanged="TextBox_TextChanged" VerticalContentAlignment="Center" HorizontalAlignment="Right" Height="23" Margin="0,0,0,0" TextWrapping="Wrap" Text="{Binding ElementName=UserControl, Path=SearchFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="176" Controls:TextBoxHelper.Watermark="Search..." Controls:TextBoxHelper.ButtonCommand="{Binding ElementName=UserControl, Path=ClearSearchCommand}" Controls:TextBoxHelper.ClearTextButton="True">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding ElementName=UserControl, Path=SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
        </Grid>
    </Grid>
</mvvm:AutoObservableUserControl>