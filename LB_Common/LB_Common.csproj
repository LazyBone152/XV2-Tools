<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>LB_Common</RootNamespace>
    <AssemblyName>LB_Common</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <Deterministic>true</Deterministic>
    <LangVersion>9</LangVersion>
		<NoWarn>CA1416</NoWarn> <!-- Supress platform API warning since this project only targets Windows -->
  </PropertyGroup>
  
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <LangVersion>14</LangVersion>
		<EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
	</PropertyGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
		<RuntimeHostConfigurationOption Include="Windows.ClipboardDragDrop.EnableUnsafeBinaryFormatterSerialization" Value="true" />
	</ItemGroup>
	
	
  <ItemGroup>
		<PackageReference Include="FastCloner" Version="3.5.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ControlzEx" Version="4.4.0" />
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="MahApps.Metro.IconPacks.MaterialLight" Version="4.11.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.19" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>
	
	<!-- .NET 10 specific reference -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
		<PackageReference Include="System.Runtime.Serialization.Formatters" Version="10.0.0" />
		<Reference Include="YAXLib">
			<SpecificVersion>False</SpecificVersion>
			<HintPath>..\..\XV2 Tools\DLLs\net10\YAXLib.dll</HintPath>
		</Reference>
	</ItemGroup>
	
	<!-- .NET Framework reference -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="YAXLib">
      <HintPath>..\DLLs\YAXLib.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>